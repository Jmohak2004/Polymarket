APP_ENV=development
SECRET_KEY=change_me_in_production

# Comma-separated origins for browser CORS (e.g. https://app.example.com). If omitted,
# APP_ENV=development allows "*"; production does not wildcard — set origins explicitly.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Blockchain
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
ORACLE_PRIVATE_KEY=your_oracle_wallet_private_key
PREDICTION_MARKET_ADDRESS=0x0000000000000000000000000000000000000000
ORACLE_RESOLVER_ADDRESS=0x0000000000000000000000000000000000000000

# AI — NVIDIA NIM Gemma 4 (https://build.nvidia.com/google/gemma-4-31b-it)
NVIDIA_API_KEY=nvapi-...
# NVIDIA_GEMMA_MODEL=google/gemma-4-31b-it
# NVIDIA_API_BASE=https://integrate.api.nvidia.com/v1

# Speech transcription (optional — Gemma resolves from transcript text)
ASSEMBLYAI_API_KEY=...

# Web source discovery — DuckDuckGo (no key) + Bing Web Search API
# Bing key from Azure Portal → Bing Search v7 resource
BING_SEARCH_API_KEY=
# BING_SEARCH_ENDPOINT=https://api.bing.microsoft.com/v7.0/search

# Weather
OPENWEATHER_API_KEY=...
TOMORROW_IO_API_KEY=...

# Redis (task queue)
REDIS_URL=redis://localhost:6379/0

# MongoDB
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=polymarket
